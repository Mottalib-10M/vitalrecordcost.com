---
/**
 * Renders one page of `src/content/pages/` in one language. Order (RECETTE §5, §9.3, §21): H1 and
 * standfirst, the tool (first screen), the folded citable block, the page's mini-tool, then the body.
 * FAQ, related pages, sources and author box come from PageLayout; the FAQ is shown and marked up
 * from the same list (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { label, groupLabel } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { byCode, marriageOf } from '../lib/engine/data';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef, ToolDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const T = lang === 'es' ? page.es : page.en;
const ui = t(lang);
const path = route(page.id, lang);
const h = helpers(lang, true);
const faqs = T.faqs(h);
const parts = T.body(h).split(/<!--tool:([a-z0-9:-]+)(?:\|(\{.*?\}))?-->/);
const jsonLd = [articleSchema({ title: T.h1, description: T.description, path, lang }), webPageSchema({ name: T.h1, description: T.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: T.nav, path }])];
jsonLd.push(webApplicationSchema({ name: T.h1, description: T.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const homeCard = lang === 'es' ? 'Tarifa del acta de nacimiento o de defunción en los 52 registros, con las copias adicionales.' : 'Birth or death certificate fee in all 52 offices, extra copies included.';
const cardOf = (id: string) => { const p = pageById(id); return (lang === 'es' ? p?.es?.card : p?.en.card) ?? (id === 'home' ? homeCard : ''); };
const related = page.related.filter((id) => hasRoute(id, lang)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: cardOf(id) }));
const base = typeof page.sources === 'function' ? page.sources(lang) : page.sources;
const sources = [...base];
if (page.state) {
  const j = byCode(page.state);
  const seen = new Set(sources.map((x) => x.url));
  const add = (name: string, url: string | null | undefined) => { if (url && !seen.has(url)) { seen.add(url); sources.unshift({ name, url }); } };
  if (page.group === 'states' && page.id.startsWith('ml-')) add(lang === 'es' ? `${h.name(page.state)}: licencia de matrimonio (página oficial)` : `${h.name(page.state)}: marriage license (official page)`, marriageOf(page.state).source);
  add(lang === 'es' ? `${j.office}: actas de defunción` : `${j.office}: death certificates`, j.sources.death);
  add(lang === 'es' ? `${j.office}: actas de nacimiento` : `${j.office}: birth certificates`, j.sources.birth);
}
const chunks: Array<{ html?: string; tool?: ToolDef }> = [];
for (let i = 0; i < parts.length; i += 3) { chunks.push({ html: parts[i] }); if (parts[i + 1]) chunks.push({ tool: { kind: parts[i + 1], props: parts[i + 2] ? JSON.parse(parts[i + 2]) : undefined } }); }
---
<PageLayout title={T.title} description={T.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: T.nav }]} dateEnHaut={false}>
  <article>
    <header class="mb-3">
      <p class="kicker">{groupLabel(page.group, lang)}</p>
      <h1 class="mt-0 text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{T.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{T.intro}</p>
    </header>
    <div data-outil class="mb-4"><Tool tool={page.tool} lang={lang} primary={true} state={page.state} /></div>
    <Clamp text={T.resume(h)} id={`clamp-${page.id}`} lang={lang} class="mb-3" />
    {page.mini && <div class="mb-4"><Tool tool={page.mini} lang={lang} idPrefix="g" state={page.state} /></div>}
    <p class="mb-8 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <div class="prose prose-slate max-w-none">
      {chunks.map((c, i) => c.html !== undefined ? <Fragment set:html={c.html} /> : <div class="not-prose"><Tool tool={c.tool!} lang={lang} idPrefix={`s${i}`} state={page.state} /></div>)}
    </div>
  </article>
</PageLayout>
