---
/** Embeddable calculator (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import OrderCalc from '../../components/calc/OrderCalc';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang={LANG_TAGS['es']}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculadora del costo de actas (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'es')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <OrderCalc client:load lang="es" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'es')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES['es']}</a></p>
  </body>
</html>
