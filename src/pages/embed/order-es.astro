---
/** Embeddable calculator (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import OrderCalc from '../../components/calc/OrderCalc';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { t } from '../../i18n/ui';
const ui = t('es');
---
<!doctype html>
<html lang={LANG_TAGS['es']}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Calculadora del costo de actas (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('home', 'es')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <OrderCalc client:load lang="es" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('home', 'es')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES['es']}</a></p>
    <p class="mt-1 text-center text-[11px] text-navy-600">{ui.footerCdcPre} <a href="https://www.cdc.gov/nchs/w2w/index.htm" target="_blank" rel="nofollow noopener" class="underline">“Where to Write for Vital Records”</a> {ui.footerCdcPost} <a href="https://www.cdc.gov/other/agencymaterials.html" target="_blank" rel="nofollow noopener" class="underline">{ui.footerCdcTerms}</a>{ui.footerCdcEnd}</p>
  </body>
</html>
