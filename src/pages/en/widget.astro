---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/order-en/" title="Certificate cost calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the certificate cost calculator on your site" description="Put the free birth and death certificate cost calculator on your site: one iframe, all 50 states, DC and New York City, extra copies and online fees, no sign-up, no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the certificate cost calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a funeral home, a library, a legal aid clinic or a hospital records desk: visitors pick the state, the record and the number of copies and see the state fee, the extra copies and the online charge.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. When a state changes its fees, the embedded calculator updates itself.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/order-en/" title="Certificate cost calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
